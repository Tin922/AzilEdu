<Project>
  <PropertyGroup>
    <!-- Arch Linux dotnet install has broken workload manifests; Rider/MSBuild need this. -->
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    <!-- Arch pacman dotnet uses RID arch-x64; NuGet only publishes linux-x64 host packs. -->
    <AppHostRuntimeIdentifier>linux-x64</AppHostRuntimeIdentifier>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
</Project>
