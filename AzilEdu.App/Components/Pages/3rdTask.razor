@page "/3rdTask"
@using System.Reflection.Metadata
@rendermode InteractiveServer

<h3>User</h3>
<label>Name: <input @bind="Name" @bind:event="oninput"/></label> 
<label>Surname: <input @bind="Surname" @bind:event="oninput"/></label> 
<p>Name: @Name Surname: @Surname</p>

@code {
   string Name = "";
   string Surname = "";
}