private int TotalHousing => housingUnits.Count;
private int ActiveHousing => housingUnits.Count(h => h.IsActive);
private int FullHousing => housingUnits.Count(h => h.Capacity == h.Occupied);
private int FreeCapacity => housingUnits.Where(h => h.IsActive)
                                        .Sum(h => h.Capacity - h.Occupied);
    
string selectedHousingFilter = "Sve";

private IEnumerable<HousingUnit> FilteredHousingUnits =>
    selectedHousingFilter switch
    {
        "Sve" => housingUnits,
        "Aktivni" => housingUnits.Where(h => h.IsActive),
        "Puni" => housingUnits.Where(h => h.Capacity == h.Occupied),
        "Sa slobodnim mjestima" => housingUnits.Where(h => h.Occupied < h.Capacity && h.IsActive),
        _ => housingUnits
    };
 
private void ShowAllHousing()
{
    selectedHousingFilter = "Sve";
}

private void ShowAllActiveHousing()
{
    selectedHousingFilter = "Aktivni";
}
private void ShowAllFullHousing()
{
    selectedHousingFilter = "Puni";
}
private void ShowFreeHousing()
{
    selectedHousingFilter = "Sa slobodnim mjestima";
}

private int GetFreeCapacity(HousingUnit unit)
{
    return unit.Capacity - unit.Occupied;
}

private string GetCleaningDateText(HousingUnit unit)
{
    if (unit.LastCleanedAt.HasValue)
    {
        return unit.LastCleanedAt.Value.ToShortDateString();
    }
 
    return "Nije uneseno";
}

private string GetUnitStatusText(HousingUnit unit)
{
    if (!unit.IsActive)
    {
        return "Neaktivno";
    }
 
    if (unit.Occupied >= unit.Capacity)
    {
        return "Puno";
    }
 
    return "Slobodno";
}

private Color GetUnitStatusColor(HousingUnit unit)
{
    if (!unit.IsActive)
    {
        return Color.Default;
    }
 
    if (unit.Occupied >= unit.Capacity)
    {
        return Color.Error;
    }
 
    return Color.Success;
}

}