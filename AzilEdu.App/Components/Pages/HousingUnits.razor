@page "/housing-units"
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject HttpClient Http
@using AzilEdu.Shared.Models

<MudText Typo="Typo.h4" GutterBottom="true">Smještajne jedinice</MudText>

<MudPaper Class="pa-4" Elevation="1">
    <MudText Typo="Typo.body1">
        Ovdje će se prikazivati boksevi, sobe i drugi prostori u kojima se životinje nalaze.
    </MudText>
</MudPaper>

<MudGrid Class="mb-4 mt-4">
    <MudItem xs="12" sm="3">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle2">Ukupan broj jedinica</MudText>
            <MudText Typo="Typo.h5">@TotalHousing</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle2">Broj aktivnih jedinica</MudText>
            <MudText Typo="Typo.h5">@ActiveHousing</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle2">Broj punih jedinica</MudText>
            <MudText Typo="Typo.h5">@FullHousing</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle2">Ukupni slobodni kapacitet</MudText>
            <MudText Typo="Typo.h5">@FreeCapacity</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>


<MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" Class="mb-4">
    <MudButton OnClick="@ShowAllHousing">Sve</MudButton>
    <MudButton OnClick="@ShowAllActiveHousing">Aktivni</MudButton>
    <MudButton OnClick="@ShowAllFullHousing">Puni</MudButton>
    <MudButton OnClick="@ShowFreeHousing">Oni sa slobodnim mjeestima</MudButton>
</MudButtonGroup>

<MudTable Items="@FilteredHousingUnits" Hover="true" Striped="true" Bordered="true" Dense="true">
    <HeaderContent>
        <MudTh>Slika</MudTh>
        <MudTh>Naziv</MudTh>
        <MudTh>Tip</MudTh>
        <MudTh>Kapacitet</MudTh>
        <MudTh>Zauzeto</MudTh>
        <MudTh>Slobodno</MudTh>
        <MudTh>Zadnje čišćenje</MudTh>
        <MudTh>Status</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Slika">
            <MudAvatar Size="Size.Large">
                <MudImage Src="@context.ImageUrl" Alt="@context.Name" />
            </MudAvatar>
        </MudTd>
        <MudTd DataLabel="Naziv">@context.Name</MudTd>
        <MudTd DataLabel="Tip">@context.UnitType</MudTd>
        <MudTd DataLabel="Kapacitet">@context.Capacity</MudTd>
        <MudTd DataLabel="Zauzeto">@context.Occupied</MudTd>
        <MudTd DataLabel="Slobodno">@GetFreeCapacity(context)</MudTd>
        <MudTd DataLabel="Zadnje čišćenje">@GetCleaningDateText(context)</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string"
                     Color="@GetUnitStatusColor(context)"
                     Variant="Variant.Filled">
                @GetUnitStatusText(context)
            </MudChip>
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    
private List<HousingUnit> housingUnits = new();

protected override async Task OnInitializedAsync()
{
    List<HousingUnit>? result = await Http.GetFromJsonAsync<List<HousingUnit>>("api/HousingUnits");
    housingUnits = result ?? new List<HousingUnit>();
}

private int TotalHousing => housingUnits.Count;
private int ActiveHousing => housingUnits.Count(h => h.IsActive);
private int FullHousing => housingUnits.Count(h => h.Capacity == h.Occupied);
private int FreeCapacity => housingUnits.Where(h => h.IsActive)
                                        .Sum(h => h.Capacity - h.Occupied);
    
string selectedHousingFilter = "Sve";

private IEnumerable<HousingUnit> FilteredHousingUnits =>
    selectedHousingFilter switch
    {
        "Sve" => housingUnits,
        "Aktivni" => housingUnits.Where(h => h.IsActive),
        "Puni" => housingUnits.Where(h => h.Capacity == h.Occupied),
        "Sa slobodnim mjestima" => housingUnits.Where(h => h.Occupied < h.Capacity && h.IsActive),
        _ => housingUnits
    };
 
private void ShowAllHousing()
{
    selectedHousingFilter = "Sve";
}

private void ShowAllActiveHousing()
{
    selectedHousingFilter = "Aktivni";
}
private void ShowAllFullHousing()
{
    selectedHousingFilter = "Puni";
}
private void ShowFreeHousing()
{
    selectedHousingFilter = "Sa slobodnim mjestima";
}

private int GetFreeCapacity(HousingUnit unit)
{
    return unit.Capacity - unit.Occupied;
}

private string GetCleaningDateText(HousingUnit unit)
{
    if (unit.LastCleanedAt.HasValue)
    {
        return unit.LastCleanedAt.Value.ToShortDateString();
    }
 
    return "Nije uneseno";
}

private string GetUnitStatusText(HousingUnit unit)
{
    if (!unit.IsActive)
    {
        return "Neaktivno";
    }
 
    if (unit.Occupied >= unit.Capacity)
    {
        return "Puno";
    }
 
    return "Slobodno";
}

private Color GetUnitStatusColor(HousingUnit unit)
{
    if (!unit.IsActive)
    {
        return Color.Default;
    }
 
    if (unit.Occupied >= unit.Capacity)
    {
        return Color.Error;
    }
 
    return Color.Success;
}

}