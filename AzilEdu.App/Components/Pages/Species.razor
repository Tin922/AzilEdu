@page "/species"
 
<MudText Typo="Typo.h4" Class="mb-2">Species</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Ovdje se prikazuju vrste životinja koje azil prima i zbrinjava.
</MudText>

<MudGrid>
    <MudItem xs="12" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudImage Src="images/cat.jpg"
                      Alt="Mačka"
                      Style="width:100%; max-width:250px;"
                      Class="mb-2" />
            <MudText Typo="Typo.h6">Mačke</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">Felis catus</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">
                Domaća mačka je mali mesožder iz obitelji mačaka. Prvobitno potječe od afričke divlje mačke, a živi uz ljude već oko 3.500 godina.
            </MudText>
            <MudText Typo="Typo.body2">Prosječni životni vijek: oko 15 godina</MudText>
            <MudText Typo="Typo.body2">Tip prehrane: Mesojed (karnivore)</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">Trenutno u azilu: 20 mačaka</MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-2"
                       Href="/species">
                Detalji
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudImage Src="images/dog.jpg"
                      Alt="Pas"
                      Style="width:100%; max-width:250px;"
                      Class="mb-2" />
            <MudText Typo="Typo.h6">Psi</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">Canis lupus</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">
                Građom tijela psi se razlikuju bitno od mačaka. Tijelo im je vitko, a glava malena s izbočenom tupom njuškom.
            </MudText>
            <MudText Typo="Typo.body2">Prosječni životni vijek: oko 15 godina</MudText>
            <MudText Typo="Typo.body2">Tip prehrane: Svejed (omnivore)</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">Trenutno u azilu: 10 pasa</MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-2"
                       Href="/species">
                Detalji
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudImage Src="images/hamster.jpg"
                      Alt="Hrčak"
                      Style="width:100%; max-width:250px;"
                      Class="mb-2" />
            <MudText Typo="Typo.h6">Hrčci</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">Cricetinae</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">
                Rasprostranjeni su u Europi i Aziji. Poznato je samo 18 vrsta svrstanih u sedam rodova, a većina živi u stepama Mongolije.
            </MudText>
            <MudText Typo="Typo.body2">Prosječni životni vijek: oko 5 godina</MudText>
            <MudText Typo="Typo.body2">Tip prehrane: Svejed (omnivore)</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">Trenutno u azilu: 5 hrčaka</MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-2"
                       Href="/species">
                Detalji
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudImage Src="images/bird.webp"
                      Alt="Ptica"
                      Style="width:100%; max-width:250px;"
                      Class="mb-2" />
            <MudText Typo="Typo.h6">Ptice</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">Aves</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">
                Ptice su toplokrvni kralježnjaci koji polažu jaja. Evoluirale su od dinosaura podreda Theropoda, a najranijom poznatom pticom smatra se Archaeopteryx.
            </MudText>
            <MudText Typo="Typo.body2">Prosječni životni vijek: oko 15 godina</MudText>
            <MudText Typo="Typo.body2">Tip prehrane: Ovisi o vrsti (sjemenke, voće, insekti)</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">Trenutno u azilu: 10 ptica</MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-2"
                       Href="/species">
                Detalji
            </MudButton>
        </MudPaper>
    </MudItem>
</MudGrid>
