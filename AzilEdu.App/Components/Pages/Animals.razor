@page "/animals"

<MudText Typo="Typo.h4" Class="mb-2">Animals</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Pregled životinja koje se nalaze u sustavu azila.
</MudText>

<MudGrid>
    <MudItem xs="12" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudImage Src="images/cat.jpg"
                      Alt="Sve životinje"
                      Style="width:100%; max-width:250px;"
                      Class="mb-2" />
            <MudText Typo="Typo.h6">Sve životinje</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">
                Pregled svih životinja evidentiranih u azilu i njihovog trenutnog statusa.
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-2">
                Otvori pregled
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudImage Src="images/dog.jpg"
                      Alt="Vrste i pasmine"
                      Style="width:100%; max-width:250px;"
                      Class="mb-2" />
            <MudText Typo="Typo.h6">Vrste i pasmine</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">
                Organizacija životinja prema vrstama i pasminama unutar sustava.
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-2"
                       Href="/species">
                Otvori pregled
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudImage Src="images/hamster.jpg"
                      Alt="Smještaj"
                      Style="width:100%; max-width:250px;"
                      Class="mb-2" />
            <MudText Typo="Typo.h6">Smještaj</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">
                Pregled bokseva, kaveza i drugih smještajnih jedinica u azilu.
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-2">
                Otvori pregled
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudImage Src="images/bird.webp"
                      Alt="Housing Units"
                      Style="width:100%; max-width:250px;"
                      Class="mb-2" />
            <MudText Typo="Typo.h6">Housing Units</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">
                Pregled bokseva, kaveza i drugih smještajnih jedinica.
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-2">
                Otvori pregled
            </MudButton>
        </MudPaper>
    </MudItem>
</MudGrid>
