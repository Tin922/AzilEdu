@page "/6thTask"
@rendermode InteractiveServer

<h3>To do List</h3>
<label>Task:
    <input @bind="toDoItem" />
</label>

<button @onclick="HandleAddingItemInList">Add Task</button>

<p>To do list:</p>
<ul>
    @foreach (string item in items)
    {
        <li>@item</li>
    }
</ul>
@code {

    List<string> items = new();
    string toDoItem = "";
    
    void HandleAddingItemInList()
    {
        if (!string.IsNullOrEmpty(toDoItem))
        {
            items.Add(toDoItem);
            toDoItem = "";
        }
    }

}