@page "/donations/create"
@rendermode InteractiveServer
 
@using AzilEdu.Shared.DTOs
@using AzilEdu.Shared.Validation
@using System.Net.Http.Json

@inject HttpClient Http
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" Class="mb-4">Nova donacija</MudText>
 
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @errorMessage
    </MudAlert>
}
 
@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else
{
    <EditForm Model="model"
              OnValidSubmit="SaveDonation"
              FormName="donation-create">
        <MudPaper Class="pa-4">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSelect T="int"
                               Label="Donator"
                               @bind-Value="model.DonorId"
                               Required="true"
                               Variant="Variant.Outlined">
                        @foreach (var donor in donors)
                        {
                            <MudSelectItem T="int" Value="@donor.Id">
                                @donor.Name
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
 
                <MudItem xs="12" md="6">
                    <MudSelect T="int"
                               Label="Tip donacije"
                               @bind-Value="SelectedDonationTypeId"
                               Required="true"
                               Variant="Variant.Outlined">
                        @foreach (var type in types)
                        {
                            <MudSelectItem T="int" Value="@type.Id">
                                @type.Name
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
 
                <MudItem xs="12" md="6">
                    <MudSelect T="int"
                               Label="Status"
                               @bind-Value="model.DonationStatusId"
                               Required="true"
                               Variant="Variant.Outlined">
                        @foreach (var status in statuses)
                        {
                            <MudSelectItem T="int" Value="@status.Id">
                                @status.Name
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
 
                <MudItem xs="12" md="6">
                    <MudDatePicker Label="Datum donacije"
                                   @bind-Date="donationDate"
                                   DateFormat="dd.MM.yyyy."
                                   Required="true"
                                   Variant="Variant.Outlined" />
                </MudItem>
 
                @if (IsMoneyDonation)
                {
                    <MudItem xs="12" md="6">
                        <MudNumericField T="decimal?"
                                         Label="Iznos u eurima"
                                         @bind-Value="model.Amount"
                                         Min="0"
                                         Required="true"
                                         Variant="Variant.Outlined" />
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" md="6">
                        <MudTextField Label="Naziv donacije"
                                      @bind-Value="model.ItemName"
                                      Required="true"
                                      Variant="Variant.Outlined" />
                    </MudItem>
 
                    <MudItem xs="12" md="3">
                        <MudNumericField T="decimal?"
                                         Label="Količina"
                                         @bind-Value="model.Quantity"
                                         Min="0"
                                         Required="true"
                                         Variant="Variant.Outlined" />
                    </MudItem>
 
                    <MudItem xs="12" md="3">
                        <MudNumericField T="decimal?"
                                         Label="Procijenjena vrijednost"
                                         @bind-Value="model.EstimatedValue"
                                         Min="0"
                                         Variant="Variant.Outlined" />
                    </MudItem>
                }
 
                <MudItem xs="12">
                    <MudTextField Label="Napomena"
                                  @bind-Value="model.Notes"
                                  Lines="4"
                                  Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
 
            <MudStack Row="true" Spacing="2" Class="mt-4">
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="isSaving">
                    @(isSaving ? "Spremam..." : "Spremi")
                </MudButton>
 
                <MudButton Href="/donations"
                           Variant="Variant.Text"
                           Disabled="isSaving">
                    Odustani
                </MudButton>
            </MudStack>
        </MudPaper>
    </EditForm>
}
 
@code {
    private SaveDonationDto model = new();
    private List<LookupDto> donors = new();
    private List<LookupDto> types = new();
    private List<LookupDto> statuses = new();
 
    private DateTime? donationDate = DateTime.Today;
    private bool isLoading = true;
    private bool isSaving;
    private string? errorMessage;
 
    private bool IsMoneyDonation => model.DonationTypeId == 1;
 
    private int SelectedDonationTypeId
    {
        get => model.DonationTypeId;
        set
        {
            if (model.DonationTypeId == value)
                return;
 
            model.DonationTypeId = value;
 
            if (value == 1)
            {
                model.ItemName = string.Empty;
                model.Quantity = null;
                model.EstimatedValue = null;
            }
            else
            {
                model.Amount = null;
            }
        }
    }
 
    protected override async Task OnInitializedAsync()
    {
        try
        {
            donors = await Http.GetFromJsonAsync<List<LookupDto>>(
                "api/donors/lookup") ?? new();
            types = await Http.GetFromJsonAsync<List<LookupDto>>(
                "api/donationtypes") ?? new();
            statuses = await Http.GetFromJsonAsync<List<LookupDto>>(
                "api/donationstatuses") ?? new();
 
            model.DonorId = donors.FirstOrDefault()?.Id ?? 0;
            SelectedDonationTypeId = types.FirstOrDefault()?.Id ?? 0;
            model.DonationStatusId = statuses.FirstOrDefault()?.Id ?? 0;
        }
        catch (Exception ex)
        {
            errorMessage = $"Formu nije moguće učitati: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
 
    private async Task SaveDonation()
    {
        if (!donationDate.HasValue)
        {
            errorMessage = "Odaberi datum donacije.";
            return;
        }

        model.DonationDate = donationDate.Value;
        errorMessage = DonationValidator.Validate(model);

        if (errorMessage is not null)
            return;

        isSaving = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/donations", model);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await ReadErrorMessage(response);
                return;
            }

            Navigation.NavigateTo("/donations");
        }
        catch (Exception ex)
        {
            errorMessage = $"Donaciju nije moguće spremiti: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private static async Task<string> ReadErrorMessage(HttpResponseMessage response)
    {
        try
        {
            var message = await response.Content.ReadFromJsonAsync<string>();
            return string.IsNullOrWhiteSpace(message)
                ? "Donaciju nije moguće spremiti."
                : message;
        }
        catch
        {
            return "Donaciju nije moguće spremiti.";
        }
    }
}