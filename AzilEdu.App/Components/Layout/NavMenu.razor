@using AzilEdu.App.Services
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation
@implements IDisposable

<div class="nav-menu-root">
    @if (!CurrentUser.IsInitialized)
    {
        <div class="d-flex justify-center pa-4">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        </div>
    }
    else if (!CurrentUser.IsLoggedIn)
    {
        <MudNavMenu Class="mud-width-full">
            <MudNavLink Href="/login" Icon="@Icons.Material.Filled.Login">
                Prijava
            </MudNavLink>
        </MudNavMenu>
    }
    else
    {
        <div class="nav-menu-header">
            <MudText Typo="Typo.subtitle1" Class="px-3 pt-3">
                @CurrentUser.User!.DisplayName
            </MudText>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="px-3 pb-3 pt-1">
                @foreach (var role in CurrentUser.User.Roles)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">@role</MudChip>
                }
            </MudStack>
        </div>

        <div class="nav-menu-links">
            <MudNavMenu Class="mud-width-full">
                <MudNavLink Href="/" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.All">
                    Dashboard
                </MudNavLink>

                @if (CurrentUser.HasAnyRole("Admin", "Employee"))
                {
                    <MudNavLink Href="/animals" Icon="@Icons.Material.Filled.Pets">
                        Životinje
                    </MudNavLink>

                    <MudNavLink Href="/volunteer-tasks" Icon="@Icons.Material.Filled.Assignment">
                        Zadaci
                    </MudNavLink>

                    <MudNavLink Href="/volunteers" Icon="@Icons.Material.Filled.VolunteerActivism">
                        Volonteri
                    </MudNavLink>

                    <MudNavLink Href="/donors" Icon="@Icons.Material.Filled.Favorite">
                        Donatori
                    </MudNavLink>

                    <MudNavLink Href="/donations" Icon="@Icons.Material.Filled.Payments">
                        Donacije
                    </MudNavLink>
                }

                @if (CurrentUser.HasRole("Admin"))
                {
                    <MudNavLink Href="/employees" Icon="@Icons.Material.Filled.Badge">
                        Djelatnici
                    </MudNavLink>

                    <MudNavLink Href="/users" Icon="@Icons.Material.Filled.ManageAccounts">
                        Korisnici i uloge
                    </MudNavLink>
                }

                @if (CurrentUser.HasRole("Volunteer"))
                {
                    <MudNavLink Href="/my-tasks" Icon="@Icons.Material.Filled.AssignmentInd">
                        Moji zadaci
                    </MudNavLink>
                }

                @if (CurrentUser.HasRole("Donor"))
                {
                    <MudNavLink Href="/my-donations" Icon="@Icons.Material.Filled.CardGiftcard">
                        Moje donacije
                    </MudNavLink>
                }
            </MudNavMenu>
        </div>

        <div class="nav-menu-footer">
            <MudDivider />
            <MudNavMenu Class="mud-width-full">
                <MudNavLink Icon="@Icons.Material.Filled.Logout"
                            OnClick="HandleLogout">
                    Odjava
                </MudNavLink>
            </MudNavMenu>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        CurrentUser.UserChanged += HandleUserChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || CurrentUser.IsInitialized)
            return;

        await CurrentUser.InitializeAsync();
    }

    private void HandleUserChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task HandleLogout()
    {
        await CurrentUser.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        CurrentUser.UserChanged -= HandleUserChanged;
    }
}
